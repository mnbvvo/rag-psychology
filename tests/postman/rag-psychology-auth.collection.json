{
  "info": {
    "_postman_id": "5f0a8d9c-2c6e-4a4f-bd1e-3a9f0c1e7b2a",
    "name": "rag-psychology 鉴权与越权（测试点1）",
    "description": "遍历所有受保护接口：无 token→401、水平越权(A访问B资源)→403、垂直越权(普通token访问admin)→403、请求体篡改user_id→403、数据隔离(A写入B查不到)。\n使用方式：先导入环境文件 rag-psychology-auth.environment.json 并选中，再按顺序 Run 本 Collection（或使用 Collection Runner）。每次运行自动生成随机用户名。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" }
  ],
  "item": [
    {
      "name": "01 注册与登录",
      "item": [
        {
          "name": "1.1 注册账号 A",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": ["pm.environment.set('userA', 'pta_' + Date.now().toString(36) + Math.floor(Math.random()*1000));"] }
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('注册 A → 201', function(){ pm.response.to.have.status(201); });"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{userA}}\",\n  \"password\": \"Test@123456\",\n  \"display_name\": \"用户A\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "1.2 注册账号 B",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": ["pm.environment.set('userB', 'ptb_' + Date.now().toString(36) + Math.floor(Math.random()*1000));"] }
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('注册 B → 201', function(){ pm.response.to.have.status(201); });"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{userB}}\",\n  \"password\": \"Test@123456\",\n  \"display_name\": \"用户B\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "1.3 登录 A（保存 token）",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('登录 A → 200', function(){ pm.response.to.have.status(200); });",
                "const j = pm.response.json();",
                "pm.environment.set('tokenA', j.access_token);",
                "pm.environment.set('userAId', j.user.id);"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{userA}}\",\n  \"password\": \"Test@123456\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "1.4 登录 B（保存 token）",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('登录 B → 200', function(){ pm.response.to.have.status(200); });",
                "const j = pm.response.json();",
                "pm.environment.set('tokenB', j.access_token);",
                "pm.environment.set('userBId', j.user.id);"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{userB}}\",\n  \"password\": \"Test@123456\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "1.5 登录管理员 admin",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('管理员登录 → 200', function(){ pm.response.to.have.status(200); });",
                "pm.environment.set('tokenAdmin', pm.response.json().access_token);"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"{{adminPassword}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "1.6 A 获取 me（token 有效）",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('A 的 me → 200', function(){ pm.response.to.have.status(200); });",
                "pm.test('用户名匹配 userA', function(){ pm.expect(pm.response.json().username).to.eql(pm.environment.get('userA')); });"
              ] }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "02 A 创建资源（会话/对比/提示词）",
      "item": [
        {
          "name": "2.1 A 新建会话（保存 sessionIdA）",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('A 新建会话 → 200', function(){ pm.response.to.have.status(200); });",
                "pm.environment.set('sessionIdA', pm.response.json().id);"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"A的会话\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/sessions", "host": ["{{baseUrl}}"], "path": ["api", "sessions"] }
          }
        },
        {
          "name": "2.2 A 新建对比记录（保存 compareIdA）",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('A 新建对比记录 → 200', function(){ pm.response.to.have.status(200); });",
                "pm.environment.set('compareIdA', pm.response.json().id);"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"input\": \"测试问题\",\n  \"a\": { \"x\": 1 },\n  \"b\": { \"x\": 2 }\n}" },
            "url": { "raw": "{{baseUrl}}/api/compare-history", "host": ["{{baseUrl}}"], "path": ["api", "compare-history"] }
          }
        },
        {
          "name": "2.3 A 新增提示词（保存 promptIdA）",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('A 新增提示词 → 200', function(){ pm.response.to.have.status(200); });",
                "const list = pm.response.json().config.prompts;",
                "const mine = list.find(p => p.name === 'A的提示词');",
                "pm.expect(mine).to.exist;",
                "pm.environment.set('promptIdA', mine.id);"
              ] }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"add\": {\n    \"name\": \"A的提示词\",\n    \"content\": \"A 的私密提示词内容\"\n  }\n}" },
            "url": { "raw": "{{baseUrl}}/api/system-prompt", "host": ["{{baseUrl}}"], "path": ["api", "system-prompt"] }
          }
        }
      ]
    },
    {
      "name": "03 无 token 访问受保护接口 → 401",
      "item": [
        { "name": "GET /api/sessions", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/sessions", "host": ["{{baseUrl}}"], "path": ["api", "sessions"] } }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('无 token → 401', function(){ pm.response.to.have.status(401); });"] } }] },
        { "name": "GET /api/system-prompt", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/system-prompt", "host": ["{{baseUrl}}"], "path": ["api", "system-prompt"] } }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('无 token → 401', function(){ pm.response.to.have.status(401); });"] } }] },
        { "name": "GET /api/compare-history", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/compare-history", "host": ["{{baseUrl}}"], "path": ["api", "compare-history"] } }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('无 token → 401', function(){ pm.response.to.have.status(401); });"] } }] },
        { "name": "GET /api/auth/me", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] } }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('无 token → 401', function(){ pm.response.to.have.status(401); });"] } }] },
        { "name": "GET /api/sessions/{id}/messages", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/sessions/{{$guid}}/messages", "host": ["{{baseUrl}}"], "path": ["api", "sessions", "{{$guid}}", "messages"] } }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('无 token → 401', function(){ pm.response.to.have.status(401); });"] } }] },
        { "name": "GET /api/admin/users", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/admin/users", "host": ["{{baseUrl}}"], "path": ["api", "admin", "users"] } }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('无 token → 401', function(){ pm.response.to.have.status(401); });"] } }] },
        { "name": "POST /api/query", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"question\": \"测试\"\n}" }, "url": { "raw": "{{baseUrl}}/api/query", "host": ["{{baseUrl}}"], "path": ["api", "query"] } }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('无 token → 401', function(){ pm.response.to.have.status(401); });"] } }] }
      ]
    },
    {
      "name": "04 水平越权（B 的 token 访问 A 的资源）→ 403",
      "item": [
        { "name": "B 读 A 的会话消息", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{tokenB}}" }], "url": { "raw": "{{baseUrl}}/api/sessions/{{sessionIdA}}/messages", "host": ["{{baseUrl}}"], "path": ["api", "sessions", "{{sessionIdA}}", "messages"] } }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('B 读 A 的会话 → 403', function(){ pm.response.to.have.status(403); });"] } }] },
        { "name": "B 改名 A 的会话", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{tokenB}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"篡改\"\n}" }, "url": { "raw": "{{baseUrl}}/api/sessions/{{sessionIdA}}", "host": ["{{baseUrl}}"], "path": ["api", "sessions", "{{sessionIdA}}"] } }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('B 改名 A 的会话 → 403', function(){ pm.response.to.have.status(403); });"] } }] },
        { "name": "B 删除 A 的会话", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{tokenB}}" }], "url": { "raw": "{{baseUrl}}/api/sessions/{{sessionIdA}}", "host": ["{{baseUrl}}"], "path": ["api", "sessions", "{{sessionIdA}}"] } }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('B 删除 A 的会话 → 403', function(){ pm.response.to.have.status(403); });"] } }] },
        { "name": "B 删除 A 的对比记录", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{tokenB}}" }], "url": { "raw": "{{baseUrl}}/api/compare-history/{{compareIdA}}", "host": ["{{baseUrl}}"], "path": ["api", "compare-history", "{{compareIdA}}"] } }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('B 删除 A 的对比记录 → 403', function(){ pm.response.to.have.status(403); });"] } }] },
        { "name": "B 更新 A 的提示词", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{tokenB}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"update\": {\n    \"id\": \"{{promptIdA}}\",\n    \"content\": \"篡改内容\"\n  }\n}" }, "url": { "raw": "{{baseUrl}}/api/system-prompt", "host": ["{{baseUrl}}"], "path": ["api", "system-prompt"] } }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('B 更新 A 的提示词 → 403', function(){ pm.response.to.have.status(403); });"] } }] },
        { "name": "B 删除 A 的提示词", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{tokenB}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"deleteId\": \"{{promptIdA}}\"\n}" }, "url": { "raw": "{{baseUrl}}/api/system-prompt", "host": ["{{baseUrl}}"], "path": ["api", "system-prompt"] } }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('B 删除 A 的提示词 → 403', function(){ pm.response.to.have.status(403); });"] } }] },
        { "name": "B 激活 A 的提示词", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{tokenB}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"activeId\": \"{{promptIdA}}\"\n}" }, "url": { "raw": "{{baseUrl}}/api/system-prompt", "host": ["{{baseUrl}}"], "path": ["api", "system-prompt"] } }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('B 激活 A 的提示词 → 403', function(){ pm.response.to.have.status(403); });"] } }] },
        { "name": "B 用 A 的 session_id 调 /api/query", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{tokenB}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"question\": \"测试\",\n  \"session_id\": \"{{sessionIdA}}\"\n}" }, "url": { "raw": "{{baseUrl}}/api/query", "host": ["{{baseUrl}}"], "path": ["api", "query"] } }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('B 用 A 的 session_id → 403', function(){ pm.response.to.have.status(403); });"] } }] },
        { "name": "B 用 A 的 prompt_id 调 /api/query", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{tokenB}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"question\": \"测试\",\n  \"prompt_id\": \"{{promptIdA}}\"\n}" }, "url": { "raw": "{{baseUrl}}/api/query", "host": ["{{baseUrl}}"], "path": ["api", "query"] } }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('B 用 A 的 prompt_id → 403', function(){ pm.response.to.have.status(403); });"] } }] }
      ]
    },
    {
      "name": "05 垂直越权（普通 token 访问 admin 接口）",
      "item": [
        { "name": "普通用户 GET /api/admin/users → 403", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{tokenB}}" }], "url": { "raw": "{{baseUrl}}/api/admin/users", "host": ["{{baseUrl}}"], "path": ["api", "admin", "users"] } }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('普通用户访问 admin → 403', function(){ pm.response.to.have.status(403); });"] } }] },
        { "name": "普通用户 GET /api/admin/crisis-audit → 403", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{tokenB}}" }], "url": { "raw": "{{baseUrl}}/api/admin/crisis-audit", "host": ["{{baseUrl}}"], "path": ["api", "admin", "crisis-audit"] } }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('普通用户访问 admin → 403', function(){ pm.response.to.have.status(403); });"] } }] },
        { "name": "管理员 GET /api/admin/users → 200", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('管理员访问 → 200', function(){ pm.response.to.have.status(200); });"] } }], "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }], "url": { "raw": "{{baseUrl}}/api/admin/users", "host": ["{{baseUrl}}"], "path": ["api", "admin", "users"] } } },
        { "name": "管理员 GET /api/admin/crisis-audit → 200", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('管理员访问 → 200', function(){ pm.response.to.have.status(200); });"] } }], "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }], "url": { "raw": "{{baseUrl}}/api/admin/crisis-audit", "host": ["{{baseUrl}}"], "path": ["api", "admin", "crisis-audit"] } } }
      ]
    },
    {
      "name": "06 请求体篡改 user_id → 403",
      "item": [
        {
          "name": "A 的 token 携带 B 的 user_id 调 /api/query",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('篡改 user_id → 403', function(){ pm.response.to.have.status(403); });"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"question\": \"测试\",\n  \"user_id\": \"{{userBId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/query", "host": ["{{baseUrl}}"], "path": ["api", "query"] }
          }
        }
      ]
    },
    {
      "name": "07 数据隔离（A 写入的数据 B 查不到）",
      "item": [
        {
          "name": "B 的会话列表不含 A 的会话",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('B 会话列表 → 200', function(){ pm.response.to.have.status(200); });",
            "const ids = pm.response.json().map(s => s.id);",
            "pm.test('B 的会话列表不含 A 的会话', function(){ pm.expect(ids).to.not.include(pm.environment.get('sessionIdA')); });"
          ] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{tokenB}}" }], "url": { "raw": "{{baseUrl}}/api/sessions", "host": ["{{baseUrl}}"], "path": ["api", "sessions"] } }
        },
        {
          "name": "B 的提示词库不含 A 的提示词",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const ids = pm.response.json().current.prompts.map(p => p.id);",
            "pm.test('B 的提示词库不含 A 的提示词', function(){ pm.expect(ids).to.not.include(pm.environment.get('promptIdA')); });"
          ] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{tokenB}}" }], "url": { "raw": "{{baseUrl}}/api/system-prompt", "host": ["{{baseUrl}}"], "path": ["api", "system-prompt"] } }
        },
        {
          "name": "A 的提示词库含自己的提示词（对照）",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const ids = pm.response.json().current.prompts.map(p => p.id);",
            "pm.test('A 的提示词库含自己的提示词', function(){ pm.expect(ids).to.include(pm.environment.get('promptIdA')); });"
          ] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }], "url": { "raw": "{{baseUrl}}/api/system-prompt", "host": ["{{baseUrl}}"], "path": ["api", "system-prompt"] } }
        },
        {
          "name": "B 的对比历史不含 A 的记录",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const ids = pm.response.json().map(h => h.id);",
            "pm.test('B 的对比历史不含 A 的记录', function(){ pm.expect(ids).to.not.include(pm.environment.get('compareIdA')); });"
          ] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{tokenB}}" }], "url": { "raw": "{{baseUrl}}/api/compare-history", "host": ["{{baseUrl}}"], "path": ["api", "compare-history"] } }
        }
      ]
    },
    {
      "name": "08 边界与安全",
      "item": [
        {
          "name": "重复注册 A → 409",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('重复注册 → 409', function(){ pm.response.to.have.status(409); });"] } }],
