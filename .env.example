# ============================================================
# rag-psychology 环境配置模板：复制为 .env 后按需修改
#   cp .env.example .env
# ============================================================

# ============ ① LLM 对话（必填） ============
# OpenAI 兼容接口密钥（DashScope/DeepSeek/本地 Ollama 等均可用）
OPENAI_API_KEY=
# 接口基地址（默认通义 DashScope 兼容模式；换服务商就改这里）
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# 对话模型
CHAT_MODEL=qwen3.6-flash

# ============ ② Embedding（可独立于 LLM 配置服务商；默认回退 ① 同套） ============
#EMBEDDING_API_KEY=
#EMBEDDING_API_BASE=
#EMBEDDING_MODEL=text-embedding-v3
#EMBEDDING_TIMEOUT_SECONDS=30

# ============ ③ 认证（JWT，必填） ============
# JWT 签名密钥：≥32 字节强随机串；缺失/太弱 → 拒绝启动（fail-closed）。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# access token 有效期（分钟）
#JWT_EXPIRE_MINUTES=120
# 首次启动 users 表为空时自动创建的管理员（生产务必改）
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123456

# ============ ④ 数据库（PostgreSQL + pgvector，必填） ============
# 前置：本机 PostgreSQL 已建库并启用扩展（见 README「新环境配置」）：
#   CREATE DATABASE rag_psychology; \c rag_psychology; CREATE EXTENSION IF NOT EXISTS vector;
DB_BACKEND=postgres
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DB=rag_psychology
# 连接池（可选，压测再调）
#DB_POOL_SIZE=10
#DB_MAX_OVERFLOW=20
#DB_POOL_TIMEOUT=30

# ============ ⑤ 向量库（生产 pgvector；chroma 仅旧本地原型） ============
VECTOR_BACKEND=pgvector
# 独立连接串（可选，留空复用 ④ 的连接）
#PGVECTOR_URL=
# 向量维度：与 EMBEDDING_MODEL 输出一致（text-embedding-v3=1024）；换模型须重导向量并重建索引
VECTOR_DIMENSION=1024

# ============ ⑥ 服务与部署（可选） ============
# 监听地址/端口（HOST 默认 127.0.0.1；上线换绑定 IP 无需改代码）
#HOST=127.0.0.1
#PORT=8000
# 跨域白名单（前端独立部署/换域名时覆盖；逗号分隔；默认 http://{HOST}:{PORT} 与 localhost）
#CORS_ORIGINS=https://h5.example.com,https://api.example.com