# OpenAI 兼容接口密钥（必填，勿提交；已被 .gitignore 忽略）
OPENAI_API_KEY=你的API密钥

# 接口基地址（默认通义千问 DashScope 兼容模式；换部署环境时覆盖）
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 对话模型（默认 qwen3.6-flash；实际部署按需覆盖，例如 deepseek-v4-flash）
CHAT_MODEL=qwen3.6-flash

# —— 本地重排序（可选，默认启用）——
# 模型目录：默认 data/rerank_models/bge-reranker-v2-m3（下载命令见 README「本地重排序」）。
# 想关闭重排（回到仅按向量分数截断）把下面设为 false 即可。
RERANK_ENABLED=true
# RERANK_MODEL=            # 留空用默认目录；也可填 HF 模型名（如 BAAI/bge-reranker-v2-m3）
# RERANK_DEVICE=           # 留空自动（优先 cuda）；可显式 cuda / cpu
# RERANK_BATCH_SIZE=8      # 每批重排文档数
# RERANK_MAX_LENGTH=512    # 单条文本截断长度（token）
# RERANK_MIN_SCORE=0       # 重排分数下限（0=不启用；bge 分数 0~1，本项目实测相关约 0.4+、无关 <0.15，建议 0.2~0.3 起试）；
#                          # 低于阈值的候选被丢弃，全部丢弃时回答会提示"没有足够信息"防编造
