# OpenAI 兼容接口密钥（必填，勿提交；已被 .gitignore 忽略）
OPENAI_API_KEY=你的API密钥

# 接口基地址（默认通义千问 DashScope 兼容模式；换部署环境时覆盖）
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 对话模型（默认 qwen3.6-flash；实际部署按需覆盖，例如 deepseek-v4-flash）
CHAT_MODEL=qwen3.6-flash

# ---------- 检索 ----------
# 相似度检索初召回候选数（应 >= RERANK_TOP_K）
FETCH_K=10
# 最终喂给模型/展示的来源条数
RERANK_TOP_K=3
# 检索模式：similarity（默认）或 mmr（最大边际相关，兼顾多样性）
SEARCH_TYPE=similarity
# mmr 模式下多样性权重：0=最多样，1=最相关
MMR_LAMBDA=0.5
# 相关性下限（0=不启用；仅未开重排时生效，重排开启时跳过该硬阈值）
MIN_RELEVANCE_SCORE=0.2

# ---------- 混合检索（向量 + BM25 关键词，仅重排开启时生效） ----------
# 是否启用：向量召回 ∪ 关键词召回 → 重排精排（心理高频词如"失眠/厌学"词面命中更可靠）
HYBRID_ENABLED=true
# 关键词（BM25）召回条数，并入向量候选后交给重排器
HYBRID_KEYWORD_K=5

# ---------- 本地重排序（bge-reranker-v2-m3） ----------
# 是否启用本地重排（true/false；false 则回到仅按向量分数截断）
RERANK_ENABLED=true
# 模型目录：默认已锚定项目根 data/rerank_models/bge-reranker-v2-m3；
# 如需覆盖请写绝对路径，或填 HF 模型名（如 BAAI/bge-reranker-v2-m3）
# RERANK_MODEL=
# 推理设备：留空自动（优先 cuda），可显式 cuda / cpu
RERANK_DEVICE=
# 每批重排文档数
RERANK_BATCH_SIZE=8
# 单条文本截断长度（token）
RERANK_MAX_LENGTH=512
# 重排分数下限（0=不启用；本项目实测相关约 0.4+、无关 <0.15，建议 0.2~0.3 起试；
# 低于阈值的候选被丢弃，全部丢弃时回答会提示"没有足够信息"防编造）
RERANK_MIN_SCORE=0

# ---------- 生成 ----------
# 生成温度（事实/建议类问答偏低以减少幻觉）
CHAT_TEMPERATURE=0.3
# 保留最近多少轮对话；超过则对更早历史做摘要压缩
MAX_HISTORY_TURNS=5

# ---------- 安全 ----------
# 是否启用关键词级危机检测（true/false）
SAFETY_CHECK_ENABLED=true

# ---------- 限流（仅 POST /api/query，内存级） ----------
# 时间窗内单客户端最大请求数
RATE_LIMIT_TIMES=20
# 限流时间窗长度（秒）
RATE_LIMIT_SECONDS=60