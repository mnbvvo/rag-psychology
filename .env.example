# OpenAI 兼容接口密钥（必填）
OPENAI_API_KEY=你的API密钥

# 接口基地址（默认通义千问 DashScope 兼容模式；换部署环境时覆盖）
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 对话模型（默认 qwen3.6-flash；实际部署按需覆盖，例如 deepseek-v4-flash）
CHAT_MODEL=qwen3.6-flash

# ============ 认证与授权（JWT，必填！） ============
# JWT 签名密钥：必须 ≥32 字节强随机串。未配置/强度不足时服务拒绝启动（防公开密钥伪造身份）。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=你的强随机密钥

# ============ 数据库（PostgreSQL + pgvector，生产推荐） ============
DB_BACKEND=postgres
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=你的数据库密码
PG_DB=rag_psychology

# 向量库后端：pgvector（向量存 PostgreSQL）| chroma（旧本地向量库）
VECTOR_BACKEND=pgvector
# 向量库独立连接串（可选）；留空则复用上面的 PostgreSQL 连接
PGVECTOR_URL=
# 向量维度（text-embedding-v3 = 1024）
VECTOR_DIMENSION=1024
